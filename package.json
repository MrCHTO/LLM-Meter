{
  "name": "llm-meter",
  "version": "1.0.0",
  "description": "本地大模型流量计量与看板",
  "main": "./out/main/index.js",
  "author": "EDY",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrCHTO/LLM-Meter.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icons": "electron scripts/make-icons.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"test/**/*.{ts,mjs,cjs}\" \"script*/*.mjs\" \"*.{ts,mjs,json,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"test/**/*.{ts,mjs,cjs}\" \"script*/*.mjs\" \"*.{ts,mjs,json,yml}\"",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.2"
  }
}
